{
  "datasets": [
    {
      "name": "next_levels",
      "displayName": "Next expiry levels",
      "queryLines": [
        "SELECT trade_date, expiry, product_code, forward, atm_vol, max_pain, gamma_flip, put_wall, call_wall,\n",
        "       sd1_low, sd1_high, sd2_low, sd2_high, put_call_oi_ratio\n",
        "FROM gold.expiry_levels\n",
        "WHERE trade_date = (SELECT max(trade_date) FROM gold.expiry_levels) AND expiry_rank = 1"
      ]
    },
    {
      "name": "next_strikes",
      "displayName": "Next expiry OI and volume by strike",
      "queryLines": [
        "SELECT p.strike, s.side, s.open_interest, s.volume\n",
        "FROM gold.strike_profile p\n",
        "JOIN gold.expiry_levels l USING (trade_date, expiry)\n",
        "LATERAL VIEW stack(2, 'Call', p.call_oi, p.call_volume, 'Put', p.put_oi, p.put_volume) s AS side, open_interest, volume\n",
        "WHERE p.trade_date = (SELECT max(trade_date) FROM gold.expiry_levels) AND p.expiry_rank = 1\n",
        "  AND p.strike BETWEEN l.sd3_low AND l.sd3_high"
      ]
    },
    {
      "name": "term_structure",
      "displayName": "Levels by expiry",
      "queryLines": [
        "SELECT expiry, product_code, business_days_to_expiry, round(atm_vol * 100, 2) AS atm_vol_pct,\n",
        "       round(sd1_low, 1) AS sd1_low, round(sd1_high, 1) AS sd1_high, max_pain, put_wall, call_wall,\n",
        "       round(gamma_flip, 1) AS gamma_flip, round(put_call_oi_ratio, 2) AS put_call_oi\n",
        "FROM gold.expiry_levels\n",
        "WHERE trade_date = (SELECT max(trade_date) FROM gold.expiry_levels) AND expiry_rank <= 10"
      ]
    },
    {
      "name": "history",
      "displayName": "Next-expiry levels over time",
      "queryLines": [
        "SELECT trade_date, s.level, s.price\n",
        "FROM gold.expiry_levels\n",
        "LATERAL VIEW stack(4, 'Forward', forward, 'Max pain', max_pain, '-1 SD', sd1_low, '+1 SD', sd1_high) s AS level, price\n",
        "WHERE expiry_rank = 1"
      ]
    }
  ],
